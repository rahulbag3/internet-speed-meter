<Window x:Class="InternetSpeedMeter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Internet Speed Meter"
        Width="720" Height="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True">
  <Grid>
    <!-- A layered window is hit-tested from the WPF surface, not from WebView2, so an
         all-transparent window swallows every click. This near-invisible plate covers the
         area the card can occupy: alpha 1 is enough for Windows to route input here, while
         the padding outside it stays transparent and click-through. -->
    <Rectangle x:Name="InputPlate" Width="580" Height="442"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Fill="#01000000" />
    <wv2:WebView2 x:Name="Web" />
  </Grid>
</Window>
