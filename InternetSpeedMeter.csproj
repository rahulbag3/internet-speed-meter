<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for NotifyIcon; the UI stays WPF. The desktop framework pack already carries
         WinForms, so the self-contained publish grows by about 200 KB compressed. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>InternetSpeedMeter</RootNamespace>
    <AssemblyName>InternetSpeedMeter</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>Internet Speed Meter</Product>
    <AssemblyTitle>Internet Speed Meter</AssemblyTitle>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WFAC010 asks WinForms apps to drop the manifest's dpiAwareness for
         Application.SetHighDpiMode. This is a WPF app: its PerMonitorV2 handling lives in
         app.manifest, MainWindow re-fits the client area from GetDpiForWindow, and the
         SetHighDpiMode route is a no-op once the manifest has already declared awareness. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- tools/ holds the verification harness, which has its own project. -->
    <Compile Remove="tools/**" />
    <None Remove="tools/**" />
    <Page Remove="tools/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms is in this build only for NotifyIcon, and TrayIcon.cs reaches it through an
         explicit alias. Its implicit global using would make bare names like Application and
         Timer ambiguous against WPF and System.Threading. -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The UI is loaded from disk at runtime, so these must land next to the exe in a
         publish as well as a build; `dotnet publish -o` wipes the folder first. -->
    <None Update="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
